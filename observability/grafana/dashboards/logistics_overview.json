      "id": 5,
      "title": "Job End-to-End Duration (p50 & p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(logistics_job_duration_seconds_bucket[1m])) by (le))",
