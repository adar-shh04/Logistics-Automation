# Digital Trade Automation Environment Variables

# App Settings
DEBUG=True

# Database (PostgreSQL inside Docker)
DATABASE_URL=postgresql://postgres:postgres@db:5432/trade_db
DATABASE_URL_JDBC=jdbc:postgresql://db:5432/trade_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (Inside Docker)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Gemini API Key for NLP extraction (REQUIRED)
GEMINI_API_KEY=

# Paths
UPLOAD_DIR=/data/uploads
HS_CSV=/app/hsdata/hs_codes.csv
LEDGER_FILE=/app/models/ledger.txt

# Observability & Load Testing
GRAFANA_ADMIN_PASSWORD=
WORKER_STUB_MODE=false
WORKER_STUB_DELAY_MS=500
